---
import { createMobiusSvg } from '@oneworks/icon/svg'

import claudeCodeIcon from '../assets/adapters/claude-code.svg'
import codexIcon from '../assets/adapters/codex.svg'
import copilotIcon from '../assets/adapters/copilot.svg'
import geminiIcon from '../assets/adapters/gemini.svg'
import kimiIcon from '../assets/adapters/kimi.svg'
import opencodeIcon from '../assets/adapters/opencode.svg'
import BrandGravityScene from '../components/BrandGravityScene.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import PageLayout from '../layouts/PageLayout.astro'
import { homepageBrandIconTheme } from '../utils/brand-icon-theme'
import {
  githubRepositoryUrl,
  homePageTitle,
  siteDescription,
  siteName
} from '../utils/site-metadata'

const adapterBadges = [
  {
    icon: claudeCodeIcon,
    edge: 'left',
    highlight: 'claude-code',
    label: 'Claude Code',
    progress: 0.24,
    style:
      '--r: -14deg; --s: 0.96; --float-x: 7px; --float-y: -6px; --tilt: 2deg; --delay: -1.2s; --duration: 7.2s;'
  },
  {
    icon: codexIcon,
    edge: 'top',
    highlight: 'codex',
    label: 'Codex',
    progress: 0.2,
    style:
      '--r: 9deg; --s: 1.04; --float-x: -5px; --float-y: 7px; --tilt: -2deg; --delay: -3.6s; --duration: 8.1s;'
  },
  {
    icon: kimiIcon,
    edge: 'top',
    highlight: 'kimi',
    label: 'Kimi',
    progress: 0.48,
    style:
      '--r: -5deg; --s: 0.98; --float-x: 6px; --float-y: 5px; --tilt: 2deg; --delay: -2.4s; --duration: 7.6s;'
  },
  {
    icon: geminiIcon,
    edge: 'bottom',
    highlight: 'ai-partner',
    label: 'Gemini',
    progress: 0.88,
    style:
      '--r: 13deg; --s: 0.86; --float-x: -7px; --float-y: -5px; --tilt: -3deg; --delay: -4.1s; --duration: 8.8s;'
  },
  {
    icon: copilotIcon,
    edge: 'left',
    highlight: 'ai-partner',
    label: 'Copilot',
    progress: 0.68,
    style:
      '--r: 8deg; --s: 0.9; --float-x: 6px; --float-y: 8px; --tilt: -2deg; --delay: -0.7s; --duration: 7.9s;'
  },
  {
    icon: opencodeIcon,
    edge: 'top',
    highlight: 'ai-partner',
    label: 'OpenCode',
    progress: 0.78,
    style:
      '--r: -11deg; --s: 0.88; --float-x: -6px; --float-y: 5px; --tilt: 2deg; --delay: -5.2s; --duration: 9.2s;'
  }
]
const mobiusMarkLight = createMobiusSvg({
  mode: 'light',
  noBackground: true,
  shadow: false,
  size: 900,
  theme: homepageBrandIconTheme,
  title: 'One Works Mobius mark'
}).replace(/^<\?xml[^>]*>\s*/, '')
const mobiusMarkDark = createMobiusSvg({
  mode: 'dark',
  noBackground: true,
  shadow: false,
  size: 900,
  theme: homepageBrandIconTheme,
  title: 'One Works Mobius mark'
}).replace(/^<\?xml[^>]*>\s*/, '')
const githubReleasesUrl = 'https://github.com/oneworks-ai/app/releases'
const downloadsManifestUrl = '/downloads.json'
const homepageDownloadUrl = githubReleasesUrl
const siteOrigin = Astro.site ?? new URL(Astro.url.origin)
const homepageStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  applicationCategory: 'DeveloperApplication',
  description: siteDescription,
  downloadUrl: homepageDownloadUrl,
  name: siteName,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD'
  },
  operatingSystem: 'macOS, Windows, Linux, Android, iOS',
  sameAs: [githubRepositoryUrl],
  softwareHelp: new URL('/docs/', siteOrigin).toString(),
  url: new URL('/', siteOrigin).toString()
}
const homepagePreviewLocale = 'zh'
const officialPwaBaseUrl = new URL(
  '/pwa/',
  Astro.site ?? 'https://oneworks.cloud/'
).toString()
const buildHomepagePreviewUrl = (baseUrl: string) => {
  const url = new URL(baseUrl)
  const basePath = url.pathname.endsWith('/')
    ? url.pathname
    : `${url.pathname}/`
  url.pathname = basePath.replace(/\/{2,}/g, '/')
  url.searchParams.set('owPreview', 'homepage')
  url.searchParams.set('locale', homepagePreviewLocale)
  url.searchParams.set('downloadUrl', homepageDownloadUrl)
  url.searchParams.set('iconTheme', homepageBrandIconTheme)
  url.searchParams.set('__oneworks_desktop', 'macos')
  url.searchParams.set('senderHeader', 'collapsed')
  url.searchParams.set('sidebar', 'collapsed')
  url.searchParams.set('adapterSelect', 'open')
  return url.toString()
}
const localPwaPreviewUrl = buildHomepagePreviewUrl(
  import.meta.env.PUBLIC_PWA_PREVIEW_URL ?? 'http://localhost:4173/'
)
const pwaPreviewUrl = import.meta.env.DEV
  ? localPwaPreviewUrl
  : buildHomepagePreviewUrl(officialPwaBaseUrl)
const buildHomepageConfigPreviewUrl = (tab: 'channels' | 'modelServices') => {
  const url = new URL(pwaPreviewUrl)
  const basePath = url.pathname.endsWith('/')
    ? url.pathname
    : `${url.pathname}/`
  url.pathname = `${basePath}config/${tab}`.replace(/\/{2,}/g, '/')
  url.searchParams.delete('adapterSelect')
  url.searchParams.set('sidebar', 'collapsed')
  return url.toString()
}
const pwaModelServicesPreviewUrl = buildHomepageConfigPreviewUrl(
  'modelServices'
)
const pwaChannelsPreviewUrl = buildHomepageConfigPreviewUrl('channels')
---

<PageLayout
  canonicalPath="/"
  description={siteDescription}
  structuredData={homepageStructuredData}
  title={homePageTitle}
>
  <main
    class="home-shell"
    aria-label="One Works homepage"
    data-downloads-manifest-url={downloadsManifestUrl}
    data-github-releases-url={githubReleasesUrl}
    data-homepage-download-url={homepageDownloadUrl}
  >
    <div class="linear-background" data-linear-background aria-hidden="true">
    </div>

    <SiteHeader downloadUrl={homepageDownloadUrl} i18n showCornerDownload />

    <section class="hero" aria-labelledby="home-hero-title">
      <div class="brand-scene">
        <BrandGravityScene />
      </div>

      <div class="hero-actions">
        <div id="download" class="download-panel">
          <h1 id="home-hero-title" class="visually-hidden" data-i18n="hero.title.line1">
            每一个 AI，每一个频道。一个工作台。
          </h1>
          <p class="visually-hidden" data-i18n="hero.summary">
            把 AI 编程伙伴、模型服务和常用频道连接到一个工作台，让上下文在工具与设备之间持续流动。
          </p>
          <div class="download-actions">
            <a
              class="download-button download-button--gravity"
              href={homepageDownloadUrl}
              data-homepage-download-link
            >
              <svg
                class="download-button__gravity-shape"
                viewBox="0 0 176 68"
                preserveAspectRatio="none"
                aria-hidden="true"
              >
                <defs>
                  <linearGradient
                    id="download-gravity-border"
                    x1="0"
                    y1="0"
                    x2="1"
                    y2="1"
                  >
                    <stop offset="0" class="download-button__border-start" />
                    <stop offset=".5" class="download-button__border-mid" />
                    <stop offset="1" class="download-button__border-end" />
                  </linearGradient>
                </defs>
                <path
                  class="download-button__gravity-surface"
                  d="M14 17 Q88 3 162 17 Q174 19 174 31 L174 48 Q174 60 162 62 Q88 48 14 62 Q2 60 2 48 L2 31 Q2 19 14 17 Z"
                />
                <path
                  class="download-button__gravity-highlight"
                  d="M14 19 Q88 6 162 19"
                />
              </svg>
              <span class="download-button__gravity-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M12 3V15M7.5 10.5 12 15l4.5-4.5M5 20h14" />
                </svg>
              </span>
              <span class="visually-hidden" data-i18n="hero.download">下载</span>
            </a>
          </div>
        </div>
      </div>

      <div class="product-stage" inert>
        <div class="adapter-badges" aria-label="Supported adapters">
          {
            adapterBadges.map((adapter) => (
              <span
                class="adapter-badge"
                aria-label={adapter.label}
                data-edge={adapter.edge}
                data-highlight-target={adapter.highlight}
                data-progress={adapter.progress}
                role="button"
                tabindex="0"
                title={adapter.label}
                style={adapter.style}
              >
                <span class="adapter-badge-card">
                  <img
                    src={adapter.icon.src}
                    alt={adapter.label}
                    loading="eager"
                  />
                </span>
              </span>
            ))
          }
        </div>

        <div class="product-window-stack">
          <div class="product-window">
            <div class="window-preview" data-pwa-preview-host>
              <div class="window-preview-poster" data-pwa-preview-poster aria-hidden="true">
                <span class="window-preview-poster-line"></span>
                <span class="window-preview-poster-line window-preview-poster-line--short"></span>
                <span class="window-preview-poster-panel"></span>
              </div>
            </div>
            <template data-pwa-preview-template>
              <iframe
                data-pwa-preview-frame
                data-new-src={pwaPreviewUrl}
                data-model-services-src={pwaModelServicesPreviewUrl}
                data-channels-src={pwaChannelsPreviewUrl}
                title="One Works PWA preview"
                loading="eager"
                referrerpolicy="no-referrer"
              ></iframe>
            </template>
          </div>
          <p class="window-tagline" data-window-tagline>
            <span class="tagline-text">
              <span>在一个应用里去调度 </span>
              <span class="tagline-token" data-highlight-token="claude-code"
              >Claude Code</span>
              <span>、</span>
              <span class="tagline-token" data-highlight-token="codex"
              >Codex</span>
              <span>、</span>
              <span class="tagline-token" data-highlight-token="kimi"
              >Kimi</span>
              <span> 等 </span>
              <span class="tagline-token" data-highlight-token="ai-partner"
              >AI 编程伙伴</span>
              <span>。</span>
            </span>
          </p>
        </div>
      </div>

      <div class="mobius-ribbon" data-mobius-loader>
        <div
          class="mobius-ribbon-static mobius-ribbon-static-light"
          data-mobius-static
          set:html={mobiusMarkLight}
        >
        </div>
        <div
          class="mobius-ribbon-static mobius-ribbon-static-dark"
          data-mobius-static
          set:html={mobiusMarkDark}
        >
        </div>
      </div>
    </section>

    <SiteFooter downloadUrl={homepageDownloadUrl} i18n />
  </main>

  <script>
  import { mountOneWorksIconLoader } from '@oneworks/icon/loader'
  import { homepageBrandIconTheme } from '../utils/brand-icon-theme'

  const initializeHomepage = () => {
    const backgroundHost = document.querySelector('[data-linear-background]')
    const host = document.querySelector('[data-mobius-loader]')
    const homeShell = document.querySelector<HTMLElement>('.home-shell')
    if (
      !(homeShell instanceof HTMLElement) ||
      homeShell.dataset.homepageInitialized === 'true'
    ) {
      return
    }
    homeShell.dataset.homepageInitialized = 'true'
    const productStage = document.querySelector<HTMLElement>('.product-stage')
    const previewWindow = document.querySelector('.product-window')
    const pwaPreviewHost = document.querySelector<HTMLElement>(
      '[data-pwa-preview-host]'
    )
    const pwaPreviewPoster = document.querySelector<HTMLElement>(
      '[data-pwa-preview-poster]'
    )
    const pwaPreviewTemplate = document.querySelector<HTMLTemplateElement>(
      '[data-pwa-preview-template]'
    )
    let pwaPreviewFrame: HTMLIFrameElement | undefined
    const languageMenu = document.querySelector<HTMLDetailsElement>(
      '[data-language-menu]'
    )
    const languageTrigger = document.querySelector<HTMLElement>(
      '[data-language-trigger]'
    )
    const languageOptions = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-language-option]')
    )
    const adapterBadges = Array.from(
      document.querySelectorAll<HTMLElement>('.adapter-badge')
    )
    const downloadLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(
        '[data-homepage-download-link]'
      )
    )
    const windowTagline = document.querySelector<HTMLElement>(
      '[data-window-tagline]'
    )
    let decorativeIconHandles: Array<
      ReturnType<typeof mountOneWorksIconLoader>
    > = []
    const cleanupDragListeners: Array<() => void> = []
    let previewResizeObserver: ResizeObserver | undefined
    const systemDarkQuery = window.matchMedia('(prefers-color-scheme: dark)')
    const desktopPreviewQuery = window.matchMedia('(min-width: 761px)')
    const getSystemMode = (): 'light' | 'dark' =>
      systemDarkQuery.matches ? 'dark' : 'light'
    const githubReleasesUrl = homeShell?.dataset.githubReleasesUrl?.trim() ||
      'https://github.com/oneworks-ai/app/releases'
    const downloadsManifestUrl =
      homeShell?.dataset.downloadsManifestUrl?.trim() || '/downloads.json'
    let currentDownloadUrl = homeShell?.dataset.homepageDownloadUrl?.trim() ||
      githubReleasesUrl
    const adapterDragLimit = 72
    let adapterPositionFrame: number | undefined
    type OrbitFocusKind = 'adapter' | 'channel' | 'model-service'
    let orbitFocusKind: OrbitFocusKind | undefined
    let orbitFocusFrame: number | undefined
    let orbitFocusProgress = 0
    let orbitFocusVelocity = 0
    let orbitFocusTarget = 0
    let orbitFocusLastTime = performance.now()
    type PreviewWindowRect = {
      height: number
      left: number
      top: number
      width: number
    }
    type HomepageLocale = 'en' | 'zh'
    type DownloadArchitecture = 'arm64' | 'unknown' | 'x64'
    type DownloadPlatform =
      | 'android'
      | 'ios'
      | 'linux'
      | 'mac'
      | 'unknown'
      | 'windows'
    type DesktopReleaseAsset = {
      architecture?: unknown
      downloadUrl?: unknown
      format?: unknown
      name?: unknown
      platform?: unknown
    }
    type DesktopRelease = {
      assets?: unknown
    }
    type DesktopDownloadsManifest = {
      fallbackUrl?: unknown
      releases?: unknown
    }
    type UserAgentDataLike = {
      getHighEntropyValues?: (
        hints: Array<'architecture' | 'platform'>
      ) => Promise<{ architecture?: string; platform?: string }>
      platform?: string
    }
    const homepageCopy: Record<HomepageLocale, Record<string, string>> = {
      en: {
        'hero.download': 'Download',
        'hero.summary':
          'Connect AI coding partners, model services, and everyday channels in one workspace, with context that keeps moving across tools and devices.',
        'hero.title.line1': 'Every AI. Every channel.',
        'footer.copyright': '© 2026 One Works. All rights reserved.',
        'footer.links.docs': 'Docs',
        'footer.links.download': 'Download',
        'footer.links.support': 'Support',
        'footer.note.local':
          'Real local project access, terminal execution, IM connections, and multi-device handoff require installing the One Works desktop app and run only within the permissions you grant.',
        'footer.note.model':
          'One Works connects AI coding partners powered by large language models. Model responses, summaries, and tool-call results may be inaccurate, incomplete, or outdated. Please verify important information before acting on it.',
        'footer.note.title': 'Please note',
        'footer.tagline': 'One app to orchestrate your AI coding partners.',
        'nav.app': 'App',
        'nav.blog': 'Blog',
        'nav.cli': 'CLI',
        'nav.docs': 'Docs',
        'nav.product': 'Product',
        'nav.pwa': 'PWA',
        languageLabel: 'Choose language'
      },
      zh: {
        'hero.download': '下载',
        'hero.summary':
          '把 AI 编程伙伴、模型服务和常用频道连接到一个工作台，让上下文在工具与设备之间持续流动。',
        'hero.title.line1': '每一个 AI，每一个频道。',
        'footer.copyright': '© 2026 One Works. 保留所有权利。',
        'footer.links.docs': '文档',
        'footer.links.download': '下载',
        'footer.links.support': '支持',
        'footer.note.local':
          '真实的本地项目访问、终端执行、IM 连接和多设备接管需要安装 One Works 桌面端，并按你的授权范围运行。',
        'footer.note.model':
          'One Works 会连接由大语言模型驱动的 AI 编程伙伴。模型回复、总结和工具调用结果可能不准确、不完整或过时，请在执行重要操作前自行确认。',
        'footer.note.title': '请注意',
        'footer.tagline': '一个应用，调度你的 AI 编程伙伴。',
        'nav.app': 'App',
        'nav.blog': '博客',
        'nav.cli': 'CLI',
        'nav.docs': '文档',
        'nav.product': '产品',
        'nav.pwa': 'PWA',
        languageLabel: '选择语言'
      }
    }
    const taglineMarkup: Record<HomepageLocale, string> = {
      en: [
        '<span class="tagline-text">',
        '<span>Orchestrate </span>',
        '<span class="tagline-token" data-highlight-token="claude-code">Claude Code</span>',
        '<span>, </span>',
        '<span class="tagline-token" data-highlight-token="codex">Codex</span>',
        '<span>, </span>',
        '<span class="tagline-token" data-highlight-token="kimi">Kimi</span>',
        '<span> and more </span>',
        '<span class="tagline-token" data-highlight-token="ai-partner">AI coding partners</span>',
        '<span> from one app.</span>',
        '</span>'
      ].join(''),
      zh: [
        '<span class="tagline-text">',
        '<span>在一个应用里去调度 </span>',
        '<span class="tagline-token" data-highlight-token="claude-code">Claude Code</span>',
        '<span>、</span>',
        '<span class="tagline-token" data-highlight-token="codex">Codex</span>',
        '<span>、</span>',
        '<span class="tagline-token" data-highlight-token="kimi">Kimi</span>',
        '<span> 等 </span>',
        '<span class="tagline-token" data-highlight-token="ai-partner">AI 编程伙伴</span>',
        '<span>。</span>',
        '</span>'
      ].join('')
    }
    const orbitFocusCopy: Record<
      HomepageLocale,
      Record<OrbitFocusKind, string>
    > = {
      en: {
        adapter:
          '<span class="tagline-text"><strong>Adapters</strong> connect Claude Code, Codex, Gemini, Kimi, Copilot, OpenCode, and Pi in one workspace.</span>',
        channel:
          '<span class="tagline-text"><strong>Channels</strong> bring ongoing AI work into the conversations and devices you already use.</span>',
        'model-service':
          '<span class="tagline-text"><strong>Model services</strong> keep providers, models, and accounts ready for every coding partner.</span>'
      },
      zh: {
        adapter:
          '<span class="tagline-text"><strong>Adapter</strong> 把 Claude Code、Codex、Gemini、Kimi、Copilot、OpenCode 和 Pi 连接到同一个工作台。</span>',
        channel:
          '<span class="tagline-text"><strong>Channel</strong> 把进行中的 AI 工作带到你常用的会话与设备里。</span>',
        'model-service':
          '<span class="tagline-text"><strong>Model Service</strong> 统一管理供应商、模型与账号，为每个 AI 编程伙伴提供服务。</span>'
      }
    }
    const normalizeHomepageLocale = (
      locale: string | null | undefined
    ): HomepageLocale => {
      return locale?.toLowerCase().startsWith('en') ? 'en' : 'zh'
    }
    const getStoredHomepageLocale = () => {
      try {
        return window.localStorage.getItem('oneworks-homepage-locale')
      } catch (error) {
        void error
        return null
      }
    }
    const setTaglineHighlight = (target: string | undefined) => {
      if (!(windowTagline instanceof HTMLElement)) {
        return
      }

      windowTagline.querySelectorAll<HTMLElement>('[data-highlight-token]')
        .forEach((token) => {
          token.classList.toggle(
            'is-highlighted',
            token.dataset.highlightToken === target
          )
        })
    }
    const renderWindowTagline = (locale: HomepageLocale) => {
      if (!(windowTagline instanceof HTMLElement)) {
        return
      }

      if (orbitFocusKind != null) {
        windowTagline.innerHTML = orbitFocusCopy[locale][orbitFocusKind]
        return
      }
      const activeTarget = windowTagline.querySelector<HTMLElement>(
        '.tagline-token.is-highlighted'
      )?.dataset.highlightToken
      windowTagline.innerHTML = taglineMarkup[locale]
      setTaglineHighlight(activeTarget)
    }
    const getHomepagePreviewLocale = () => {
      return normalizeHomepageLocale(
        document.documentElement.lang || navigator.language || 'zh'
      )
    }
    const getNavigatorUserAgentData = () => {
      return (navigator as Navigator & { userAgentData?: UserAgentDataLike })
        .userAgentData
    }
    const normalizeReleaseString = (value: unknown) => {
      return typeof value === 'string' ? value.trim() : ''
    }
    const resolveDownloadTarget = async (): Promise<{
      architecture: DownloadArchitecture
      platform: DownloadPlatform
    }> => {
      const uaData = getNavigatorUserAgentData()
      let highEntropyValues:
        | { architecture?: string; platform?: string }
        | undefined
      try {
        highEntropyValues = await uaData?.getHighEntropyValues?.([
          'architecture',
          'platform'
        ])
      } catch (error) {
        void error
      }

      const platformText = [
        navigator.platform,
        navigator.userAgent,
        uaData?.platform,
        highEntropyValues?.platform
      ].filter(Boolean).join(' ').toLowerCase()
      const architectureText = [
        highEntropyValues?.architecture,
        navigator.platform,
        navigator.userAgent
      ].filter(Boolean).join(' ').toLowerCase()
      const platform: DownloadPlatform = platformText.includes('android')
        ? 'android'
        : platformText.includes('iphone') ||
            platformText.includes('ipad') ||
            platformText.includes('ipod') ||
            (platformText.includes('macintosh') &&
              navigator.maxTouchPoints > 1)
        ? 'ios'
        : platformText.includes('mac') || platformText.includes('darwin')
        ? 'mac'
        : platformText.includes('win')
        ? 'windows'
        : platformText.includes('linux')
        ? 'linux'
        : 'unknown'
      const architecture: DownloadArchitecture =
        architectureText.includes('arm') ||
          architectureText.includes('aarch64')
          ? 'arm64'
          : architectureText.includes('x86') ||
              architectureText.includes('x64') ||
              architectureText.includes('amd64') ||
              architectureText.includes('intel')
          ? 'x64'
          : 'unknown'

      return { architecture, platform }
    }
    const fetchDesktopDownloadsManifest = async () => {
      try {
        const response = await fetch(downloadsManifestUrl, {
          headers: { Accept: 'application/json' }
        })
        if (!response.ok) {
          return undefined
        }

        return await response.json() as DesktopDownloadsManifest
      } catch (error) {
        void error
        return undefined
      }
    }
    const getReleaseAssets = (release: DesktopRelease) => {
      return Array.isArray(release.assets)
        ? release.assets as DesktopReleaseAsset[]
        : []
    }
    const scoreDownloadAsset = (
      asset: DesktopReleaseAsset,
      target: {
        architecture: DownloadArchitecture
        platform: DownloadPlatform
      }
    ) => {
      const assetName = normalizeReleaseString(asset.name).toLowerCase()
      const assetArchitecture = normalizeReleaseString(asset.architecture)
      const assetFormat = normalizeReleaseString(asset.format).toLowerCase()
      const assetPlatform = normalizeReleaseString(asset.platform)
      const downloadUrl = normalizeReleaseString(asset.downloadUrl)
      if (assetName === '' || downloadUrl === '') {
        return -1
      }
      if (assetPlatform !== target.platform) return -1

      if (target.platform === 'mac') {
        let score = 100
        if (
          target.architecture !== 'unknown' &&
          assetArchitecture === target.architecture
        ) {
          score += 30
        }
        if (assetFormat === 'dmg') {
          score += 20
        } else if (assetFormat === 'pkg') {
          score += 10
        } else if (assetFormat === 'zip') {
          score += 5
        }
        return score
      }

      if (target.platform === 'linux') {
        let score = 100
        if (
          target.architecture === 'x64' &&
          assetArchitecture === 'x64'
        ) {
          score += 30
        }
        if (assetFormat === 'appimage') {
          score += 20
        } else if (assetFormat === 'deb') {
          score += 10
        } else if (assetFormat === 'tar.gz') {
          score += 5
        }
        return score
      }

      if (target.platform === 'windows') {
        let score = 100
        if (
          target.architecture === 'x64' &&
          assetArchitecture === 'x64'
        ) {
          score += 30
        }
        if (assetFormat === 'exe') {
          score += 20
        } else if (assetFormat === 'msi') {
          score += 10
        } else if (assetFormat === 'zip') {
          score += 5
        }
        return score
      }

      if (target.platform === 'android') {
        if (assetFormat !== 'apk') {
          return -1
        }
        let score = 100
        if (
          target.architecture !== 'unknown' &&
          assetArchitecture === target.architecture
        ) {
          score += 30
        }
        return score + 20
      }

      if (target.platform === 'ios') {
        let score = 100
        if (
          target.architecture !== 'unknown' &&
          assetArchitecture === target.architecture
